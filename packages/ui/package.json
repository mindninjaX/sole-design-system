{
  "name": "@soleapp/ui",
  "version": "0.1.0",
  "description": "Sole's design system. This release holds the design tokens (colour, type, radius, elevation, motion) as CSS, DTCG JSON and a JavaScript object; the components come in later versions.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mindninjaX/sole-design-system.git",
    "directory": "packages/ui"
  },
  "homepage": "https://mindninjax.github.io/sole-design-system/",
  "bugs": {
    "url": "https://github.com/mindninjaX/sole-design-system/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "npm run build -w @sole/tokens --prefix ../.. && node scripts/build.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0"
  },
  "peerDependencies": {
    "tailwindcss": "^4.1.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  }
}
